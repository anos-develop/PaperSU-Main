+              CAP_BBRV3=1 CAP_TCP_BBR3=1 CAP_HMBIRD_GKI=0 CAP_NTSYNC_612=0 ;;
+            android13-5.15)
+              CAP_V510=0 CAP_V515=1 CAP_V515_LEGACY=1 CAP_V61=0 CAP_V66=0 CAP_V612=0 CAP_V6PLUS=0
+              CAP_BBRV3=1 CAP_TCP_BBR3=1 CAP_HMBIRD_GKI=0 CAP_NTSYNC_612=0 ;;
+            android14-5.15)
+              CAP_V510=0 CAP_V515=1 CAP_V515_LEGACY=0 CAP_V61=0 CAP_V66=0 CAP_V612=0 CAP_V6PLUS=0
+              CAP_BBRV3=0 CAP_TCP_BBR3=1 CAP_HMBIRD_GKI=0 CAP_NTSYNC_612=0 ;;
+            android14-6.1)
+              CAP_V510=0 CAP_V515=0 CAP_V515_LEGACY=0 CAP_V61=1 CAP_V66=0 CAP_V612=0 CAP_V6PLUS=1
+              CAP_BBRV3=1 CAP_TCP_BBR3=1 CAP_HMBIRD_GKI=0 CAP_NTSYNC_612=0 ;;
+            android15-6.6)
+              CAP_V510=0 CAP_V515=0 CAP_V515_LEGACY=0 CAP_V61=0 CAP_V66=1 CAP_V612=0 CAP_V6PLUS=1
+              CAP_BBRV3=1 CAP_TCP_BBR3=1 CAP_HMBIRD_GKI=1 CAP_NTSYNC_612=0 ;;
+            android16-6.12)
+              CAP_V510=0 CAP_V515=0 CAP_V515_LEGACY=0 CAP_V61=0 CAP_V66=0 CAP_V612=1 CAP_V6PLUS=1
+              CAP_BBRV3=0 CAP_TCP_BBR3=0 CAP_HMBIRD_GKI=1 CAP_NTSYNC_612=1 ;;
+            *)
+              echo "::error::这台设备的内核不在受支持列表里：KMI=$KMI"
+              echo "::error::受支持：android12-5.10 / android13-5.15 / android14-5.15 / android14-6.1 / android15-6.6 / android16-6.12"
+              echo "::error::要加新版本，请先确认 patches/bbrv3 与 patches/ntsync 下有对应补丁文件，然后在本表加一行。"
+              exit 1 ;;
+          esac
+
+          echo "--- 能力位 ---"
+          for cap in CAP_V510 CAP_V515 CAP_V515_LEGACY CAP_V61 CAP_V66 CAP_V612 CAP_V6PLUS \
+                     CAP_BBRV3 CAP_TCP_BBR3 CAP_HMBIRD_GKI CAP_NTSYNC_612; do
+            eval "val=\${$cap}"
+            echo "$cap=$val" >> "$GITHUB_ENV"
+            printf '  %-16s = %s\n' "$cap" "$val"
+          done
+          echo "✅ 能力位已写入 GITHUB_ENV"
