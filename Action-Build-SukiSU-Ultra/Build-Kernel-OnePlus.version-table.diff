+      # ════════════════════════════════════════════════════════════════════════
+      - name: Resolve Version Capabilities
+        run: |
+          KMI="${KMI:-}"
+          if [ -z "$KMI" ]; then
+            echo "::error::未能确定 KMI —— build.config* 与 ACK_SHA 都没给出"
