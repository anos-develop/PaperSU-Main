+
+          # 交叉校验：KMI 里声明的版本 vs common/Makefile 里的实际版本。
+          # 正常情况下两者一致（android12-5.10 ↔ VERSION=5 PATCHLEVEL=10）。
+          # 不一致说明清单选错了、或源码与清单对不上 —— 这种情况必须让人看见，
+          # 因为下面那张表是按 KMI 取值的，而报错信息/伪装版本是按 Makefile 走的。
+          MK_VER="${VERSIONLEVEL:-}.${PATCHLEVEL:-}"
+          KMI_VER="${KMI#*-}"
+          if [ -n "${VERSIONLEVEL:-}" ] && [ "$MK_VER" != "$KMI_VER" ]; then
