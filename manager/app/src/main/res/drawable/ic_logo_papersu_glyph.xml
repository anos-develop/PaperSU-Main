<?xml version="1.0" encoding="utf-8"?>
<!-- paperSU glyph: 只有字母 P 和它下面那道横杠，背景透明（关于页用）。
     启动画面必须用带板的 ic_logo_papersu，否则那屏会是一片黑。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="500"
    android:viewportHeight="500">
    <group
        android:name="glyph_content"
        android:pivotX="250"
        android:pivotY="250"
        android:scaleX="0.82"
        android:scaleY="0.82">
        <path
            android:name="papersu_p"
            android:fillColor="@android:color/transparent"
            android:pathData="M185,365 V165 H290 A62,62 0 0 1 290,289 H185"
            android:strokeWidth="38"
            android:strokeColor="@color/ic_launcher_foreground"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:name="papersu_underline"
            android:fillColor="@android:color/transparent"
            android:pathData="M172,412 H328"
            android:strokeWidth="20"
            android:strokeColor="@color/ic_splash_accent"
            android:strokeLineCap="round" />
    </group>
</vector>