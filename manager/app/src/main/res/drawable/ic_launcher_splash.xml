<?xml version="1.0" encoding="utf-8"?>
<!-- paperSU splash animation. Replaces the upstream KernelSU outline/square
     animated vector: the paperSU "P" is drawn on stroke by stroke, then the
     accent underline sweeps in. Duration matches
     windowSplashScreenAnimationDuration (500 ms) in values/themes.xml. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_logo_papersu">
    <target
        android:name="papersu_p"
        android:animation="@animator/anim_papersu_p" />
    <target
        android:name="papersu_underline"
        android:animation="@animator/anim_papersu_underline" />
</animated-vector>
